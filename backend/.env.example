# Copy to .env and edit if your MongoDB is elsewhere. Prototype runs fine WITHOUT
# Mongo too — if it can't connect, the backend logs a warning and keeps working
# with in-memory-only state (no persistence across restarts).
MONGODB_URI=mongodb://127.0.0.1:27017/fogsafe
PORT=4000
# Set this to your deployed frontend URL(s) once known, e.g.:
# CORS_ORIGIN=https://fogsafe.vercel.app
CORS_ORIGIN=
